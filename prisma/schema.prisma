generator client {
  provider = "prisma-client-js"
  output   = "../prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HelperData {
  id          Int      @id @default(autoincrement())
  address     String   @unique
  helperData  String   

  @@map("helper_data")
}